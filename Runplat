<!DOCTYPE html>

<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PharmaComply — Pharmaceutical Regulatory Intelligence Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
 :root {
   --bg: #080f1a;
   --surface: #0e1929;
   --surface2: #131f30;
   --surface3: #192638;
   --gold: #b8922a;
   --gold-light: #d4a93c;
   --gold-bright: #f0c35e;
   --teal: #2a8b8b;
   --teal-light: #3aadad;
   --red: #c04040;
   --green: #2a8b5a;
   --green-light: #38b578;
   --amber: #b87a20;
   --text: #d8e4f0;
   --text-muted: #6a82a0;
   --text-dim: #3a4f6a;
   --border: rgba(184,146,42,0.15);
   --border-soft: rgba(255,255,255,0.05);
   --glow: rgba(184,146,42,0.08);
   --radius: 10px;
 }

- { margin: 0; padding: 0; box-sizing: border-box; }
 html { scroll-behavior: smooth; }

body {
background: var(–bg);
color: var(–text);
font-family: ‘Inter’, sans-serif;
font-size: 13.5px;
line-height: 1.6;
overflow-x: hidden;
}

body::before {
content: ‘’;
position: fixed; inset: 0; pointer-events: none; z-index: 0;
background:
radial-gradient(ellipse 70% 50% at 15% 0%, rgba(184,146,42,0.06) 0%, transparent 55%),
radial-gradient(ellipse 50% 70% at 85% 100%, rgba(42,139,139,0.05) 0%, transparent 55%),
repeating-linear-gradient(0deg, transparent, transparent 40px, rgba(255,255,255,0.008) 40px, rgba(255,255,255,0.008) 41px),
repeating-linear-gradient(90deg, transparent, transparent 40px, rgba(255,255,255,0.008) 40px, rgba(255,255,255,0.008) 41px);
}

/* ===== SIDEBAR ===== */
.sidebar {
position: fixed; left: 0; top: 0; bottom: 0; width: 248px;
background: var(–surface);
border-right: 1px solid var(–border);
display: flex; flex-direction: column;
z-index: 100;
}

.sidebar-logo {
padding: 26px 22px 20px;
border-bottom: 1px solid var(–border);
}
.logo-icon {
width: 38px; height: 38px;
background: linear-gradient(135deg, var(–gold), var(–gold-light));
border-radius: 9px;
display: flex; align-items: center; justify-content: center;
font-size: 18px; margin-bottom: 10px;
box-shadow: 0 4px 16px rgba(184,146,42,0.3);
}
.logo-name {
font-family: ‘Cormorant Garamond’, serif;
font-size: 21px; font-weight: 700;
color: var(–gold-bright);
letter-spacing: 0.3px;
}
.logo-sub {
font-size: 9.5px; color: var(–text-muted);
text-transform: uppercase; letter-spacing: 2.5px;
margin-top: 1px;
}

.nav-group { padding: 14px 12px 6px; }
.nav-group-label {
font-size: 9px; font-weight: 600;
color: var(–text-dim); text-transform: uppercase;
letter-spacing: 2px; padding: 0 8px; margin-bottom: 5px;
}

.nav-item {
display: flex; align-items: center; gap: 9px;
padding: 9px 10px; border-radius: 7px;
cursor: pointer; transition: all 0.18s;
color: var(–text-muted); font-size: 13px; font-weight: 500;
margin-bottom: 1px; position: relative;
border: 1px solid transparent;
}
.nav-item:hover { background: rgba(255,255,255,0.04); color: var(–text); }
.nav-item.active {
background: var(–glow);
color: var(–gold-light);
border-color: var(–border);
}
.nav-item.active::before {
content: ‘’; position: absolute; left: 0; top: 50%;
transform: translateY(-50%);
width: 3px; height: 18px; border-radius: 2px;
background: var(–gold);
}
.nav-icon { font-size: 14px; width: 18px; text-align: center; opacity: 0.85; }
.nav-badge {
margin-left: auto; background: var(–red);
color: #fff; font-size: 9px; font-weight: 700;
padding: 2px 5px; border-radius: 8px; letter-spacing: 0.3px;
}
.nav-badge-gold {
margin-left: auto; background: rgba(184,146,42,0.2);
color: var(–gold-light); font-size: 9px; font-weight: 700;
padding: 2px 6px; border-radius: 8px;
}

.sidebar-bottom {
margin-top: auto;
border-top: 1px solid var(–border);
padding: 14px 16px;
}
.user-row { display: flex; align-items: center; gap: 10px; }
.user-av {
width: 32px; height: 32px; border-radius: 50%;
background: linear-gradient(135deg, var(–gold), var(–teal));
display: flex; align-items: center; justify-content: center;
font-size: 12px; font-weight: 700; color: var(–bg); flex-shrink: 0;
}
.user-name { font-size: 12.5px; font-weight: 600; color: var(–text); }
.user-role { font-size: 10.5px; color: var(–text-muted); }

/* ===== MAIN ===== */
.main { margin-left: 248px; position: relative; z-index: 1; min-height: 100vh; }

/* ===== TOPBAR ===== */
.topbar {
height: 58px;
background: rgba(8,15,26,0.92);
backdrop-filter: blur(16px);
border-bottom: 1px solid var(–border-soft);
display: flex; align-items: center;
padding: 0 28px; gap: 14px;
position: sticky; top: 0; z-index: 50;
}
.topbar-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: 18px; font-weight: 600; color: var(–text);
letter-spacing: 0.2px;
}
.topbar-sep { color: var(–text-dim); margin: 0 2px; }

.search-wrap {
margin-left: auto;
display: flex; align-items: center; gap: 7px;
background: var(–surface2);
border: 1px solid var(–border-soft);
border-radius: 8px; padding: 6px 13px;
width: 240px; transition: border-color 0.2s;
}
.search-wrap:focus-within { border-color: var(–border); }
.search-wrap input {
background: none; border: none; outline: none;
color: var(–text); font-size: 12.5px;
font-family: ‘Inter’, sans-serif; width: 100%;
}
.search-wrap input::placeholder { color: var(–text-dim); }

.topbar-tag {
background: rgba(42,139,139,0.15);
color: var(–teal-light); font-size: 10px; font-weight: 600;
padding: 3px 8px; border-radius: 5px;
text-transform: uppercase; letter-spacing: 1px;
}

/* ===== CONTENT ===== */
.content { padding: 26px 28px; }
.page { display: none; }
.page.active { display: block; }

/* ===== DASHBOARD ===== */
.kpi-row {
display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px;
margin-bottom: 22px;
}
.kpi {
background: var(–surface2);
border: 1px solid var(–border-soft);
border-radius: var(–radius);
padding: 16px 18px;
transition: border-color 0.2s;
position: relative; overflow: hidden;
}
.kpi::after {
content: ‘’;
position: absolute; top: 0; left: 0; right: 0; height: 2px;
background: linear-gradient(90deg, var(–gold), transparent);
opacity: 0;
transition: opacity 0.2s;
}
.kpi:hover { border-color: var(–border); }
.kpi:hover::after { opacity: 1; }
.kpi-label { font-size: 10px; color: var(–text-muted); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 500; }
.kpi-value {
font-family: ‘Cormorant Garamond’, serif;
font-size: 30px; font-weight: 700; color: var(–gold-bright);
line-height: 1.1; margin: 5px 0 2px;
}
.kpi-sub { font-size: 11px; color: var(–text-muted); }

/* ===== GRID ===== */
.g2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.g3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; }

/* ===== SECTION HEADER ===== */
.sh {
display: flex; align-items: center; justify-content: space-between;
margin-bottom: 14px;
}
.sh-title {
font-family: ‘Cormorant Garamond’, serif;
font-size: 17px; font-weight: 600; color: var(–text);
display: flex; align-items: baseline; gap: 8px;
}
.sh-title span { color: var(–gold); }
.sh-title small { font-family: ‘Inter’, sans-serif; font-size: 11px; color: var(–text-muted); font-weight: 400; }

/* ===== BUTTONS ===== */
.btn {
padding: 7px 16px; border-radius: 7px; border: none;
font-family: ‘Inter’, sans-serif; font-size: 12px; font-weight: 600;
cursor: pointer; transition: all 0.18s; letter-spacing: 0.2px;
}
.btn-gold { background: var(–gold); color: var(–bg); }
.btn-gold:hover { background: var(–gold-light); }
.btn-ghost { background: transparent; color: var(–gold); border: 1px solid var(–border); }
.btn-ghost:hover { background: var(–glow); }
.btn-sm { padding: 5px 11px; font-size: 11px; }

/* ===== CARDS ===== */
.card {
background: var(–surface2);
border: 1px solid var(–border-soft);
border-radius: var(–radius);
}
.card-hd {
padding: 15px 18px;
border-bottom: 1px solid var(–border-soft);
display: flex; align-items: center; justify-content: space-between;
}
.card-title { font-size: 13px; font-weight: 600; color: var(–text); }
.card-bd { padding: 16px 18px; }

/* ===== STATUS PILLS ===== */
.pill {
font-size: 10px; font-weight: 600; padding: 2px 8px;
border-radius: 5px; letter-spacing: 0.5px; text-transform: uppercase;
display: inline-flex; align-items: center; gap: 4px;
}
.pill-green { background: rgba(42,139,90,0.18); color: var(–green-light); }
.pill-amber { background: rgba(184,122,32,0.18); color: #e8a840; }
.pill-red { background: rgba(192,64,64,0.18); color: #e06060; }
.pill-teal { background: rgba(42,139,139,0.18); color: var(–teal-light); }
.pill-gold { background: rgba(184,146,42,0.18); color: var(–gold-bright); }

/* ===== COUNTRY CARDS ===== */
.country-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
gap: 14px;
}
.cc {
background: var(–surface2);
border: 1px solid var(–border-soft);
border-radius: var(–radius);
padding: 18px 18px 16px;
cursor: pointer;
transition: all 0.22s;
position: relative; overflow: hidden;
}
.cc::before {
content: ‘’; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
border-radius: 2px 0 0 2px;
transition: opacity 0.2s;
opacity: 0;
}
.cc.s-active::before { background: var(–green-light); opacity: 1; }
.cc.s-review::before { background: #e8a840; opacity: 1; }
.cc.s-planned::before { background: var(–text-muted); opacity: 1; }
.cc:hover { border-color: var(–border); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,0.4); }

.cc-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 10px; }
.cc-flag { font-size: 28px; }
.cc-name { font-family: ‘Cormorant Garamond’, serif; font-size: 16px; font-weight: 700; color: var(–text); }
.cc-sub { font-size: 11px; color: var(–text-muted); margin-bottom: 10px; }
.cc-tags { display: flex; gap: 5px; flex-wrap: wrap; margin-bottom: 10px; }
.tag {
font-size: 9.5px; padding: 2px 7px; border-radius: 4px;
font-weight: 600; letter-spacing: 0.5px;
}
.tag-green { background: rgba(42,139,90,0.15); color: var(–green-light); }
.tag-gold { background: rgba(184,146,42,0.15); color: var(–gold-bright); }
.tag-teal { background: rgba(42,139,139,0.15); color: var(–teal-light); }
.tag-red { background: rgba(192,64,64,0.15); color: #e06060; }
.tag-blue { background: rgba(60,100,200,0.15); color: #7aadff; }

.cc-foot {
display: flex; align-items: center; justify-content: space-between;
font-size: 11px; color: var(–text-muted);
padding-top: 10px; border-top: 1px solid var(–border-soft);
}

/* ===== DOT ===== */
.dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
.dot-green { background: var(–green-light); box-shadow: 0 0 6px var(–green-light); }
.dot-amber { background: #e8a840; box-shadow: 0 0 6px #e8a840; }
.dot-grey { background: var(–text-muted); }

/* ===== DETAIL PANEL ===== */
.overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 150; backdrop-filter: blur(4px); }
.overlay.open { display: block; }

.detail {
display: none; position: fixed; right: 0; top: 0; bottom: 0; width: 540px;
background: var(–surface);
border-left: 1px solid var(–border);
z-index: 200; overflow-y: auto;
animation: slideIn 0.28s cubic-bezier(.4,0,.2,1);
}
.detail.open { display: block; }
@keyframes slideIn { from { transform: translateX(100%); opacity: 0.5; } to { transform: translateX(0); opacity: 1; } }

.dp-head {
padding: 26px 26px 20px;
border-bottom: 1px solid var(–border);
position: sticky; top: 0;
background: var(–surface); z-index: 1;
}
.dp-close {
position: absolute; right: 18px; top: 18px;
width: 28px; height: 28px; border-radius: 50%;
background: var(–surface3); border: 1px solid var(–border-soft);
color: var(–text-muted); cursor: pointer; font-size: 14px;
display: flex; align-items: center; justify-content: center;
transition: all 0.15s;
}
.dp-close:hover { color: var(–text); border-color: var(–border); }

.dp-body { padding: 22px 26px; }
.dp-section { margin-bottom: 22px; }
.dp-section-title {
font-size: 9.5px; font-weight: 600;
text-transform: uppercase; letter-spacing: 2px;
color: var(–gold); margin-bottom: 10px;
display: flex; align-items: center; gap: 7px;
}
.dp-section-title::after {
content: ‘’; flex: 1; height: 1px; background: var(–border);
}

.law-item {
background: var(–surface3);
border: 1px solid var(–border-soft);
border-radius: 8px; padding: 13px 15px;
margin-bottom: 8px;
transition: border-color 0.15s;
}
.law-item:hover { border-color: var(–border); }
.law-name { font-size: 12.5px; font-weight: 600; color: var(–text); margin-bottom: 3px; }
.law-cat { font-size: 10px; color: var(–gold); font-weight: 600; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 5px; }
.law-desc { font-size: 11.5px; color: var(–text-muted); line-height: 1.55; }
.law-link {
display: inline-flex; align-items: center; gap: 4px;
font-size: 10.5px; color: var(–teal-light); margin-top: 7px;
cursor: pointer; text-decoration: none; transition: color 0.15s;
}
.law-link:hover { color: #60d0d0; }

.contact-row {
display: flex; align-items: flex-start; gap: 11px;
background: var(–surface3);
border: 1px solid var(–border-soft);
border-radius: 8px; padding: 12px 14px;
margin-bottom: 8px;
}
.c-av {
width: 36px; height: 36px; border-radius: 50%;
background: var(–surface2); border: 1px solid var(–border);
display: flex; align-items: center; justify-content: center;
font-size: 15px; flex-shrink: 0;
}
.c-name { font-size: 12.5px; font-weight: 600; color: var(–text); }
.c-role { font-size: 10.5px; color: var(–gold); margin-bottom: 3px; }
.c-info { font-size: 11px; color: var(–text-muted); }

/* ===== PROCESS STEPS ===== */
.process-steps { display: flex; flex-direction: column; gap: 0; }
.step {
display: flex; gap: 14px;
padding-bottom: 16px;
position: relative;
}
.step:last-child { padding-bottom: 0; }
.step-num {
width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
display: flex; align-items: center; justify-content: center;
font-size: 11px; font-weight: 700; color: var(–bg);
background: var(–gold); z-index: 1;
box-shadow: 0 0 0 3px var(–surface2);
}
.step:not(:last-child) .step-num::after {
content: ‘’; position: absolute;
left: 13px; top: 28px; width: 2px;
bottom: 0;
background: linear-gradient(to bottom, var(–border), transparent);
}
.step-content { flex: 1; }
.step-title { font-size: 12.5px; font-weight: 600; color: var(–text); margin-bottom: 3px; }
.step-desc { font-size: 11.5px; color: var(–text-muted); line-height: 1.5; }

/* ===== TABLE ===== */
.tbl { width: 100%; border-collapse: collapse; }
.tbl th {
text-align: left; font-size: 10px; text-transform: uppercase;
letter-spacing: 1.5px; color: var(–text-muted); font-weight: 600;
padding: 8px 13px; border-bottom: 1px solid var(–border-soft);
}
.tbl td {
padding: 10px 13px;
border-bottom: 1px solid rgba(255,255,255,0.03);
font-size: 12.5px; color: var(–text); vertical-align: middle;
}
.tbl tr:hover td { background: rgba(255,255,255,0.02); cursor: pointer; }
.tbl tr:last-child td { border-bottom: none; }

/* ===== AI AGENT ===== */
.ai-wrap { display: flex; gap: 18px; height: calc(100vh - 136px); }

.ai-sidebar {
width: 240px; flex-shrink: 0;
display: flex; flex-direction: column; gap: 10px;
overflow-y: auto;
}

.ai-panel {
flex: 1;
background: var(–surface2);
border: 1px solid var(–border-soft);
border-radius: var(–radius);
display: flex; flex-direction: column;
overflow: hidden;
}

.ai-head {
padding: 14px 18px;
border-bottom: 1px solid var(–border-soft);
display: flex; align-items: center; gap: 12px;
background: var(–surface3);
}
.ai-av-main {
width: 38px; height: 38px; border-radius: 50%;
background: linear-gradient(135deg, var(–gold), var(–teal));
display: flex; align-items: center; justify-content: center;
font-size: 17px; flex-shrink: 0;
box-shadow: 0 0 16px rgba(184,146,42,0.25);
}
.ai-name-main { font-size: 14px; font-weight: 600; color: var(–text); }
.ai-status-line { font-size: 10px; color: var(–green-light); display: flex; align-items: center; gap: 5px; }

.chat-area {
flex: 1; overflow-y: auto; padding: 18px;
display: flex; flex-direction: column; gap: 14px;
}
.msg { display: flex; gap: 9px; max-width: 88%; }
.msg.user { margin-left: auto; flex-direction: row-reverse; }
.msg-av {
width: 28px; height: 28px; border-radius: 50%;
display: flex; align-items: center; justify-content: center;
font-size: 12px; flex-shrink: 0; margin-top: 2px;
}
.msg-av.ai-type { background: linear-gradient(135deg, var(–gold), var(–teal)); color: var(–bg); font-size: 14px; }
.msg-av.user-type { background: rgba(42,139,139,0.25); color: var(–teal-light); font-weight: 700; font-size: 10px; }
.msg-bubble {
padding: 10px 14px; border-radius: 10px;
font-size: 12.5px; line-height: 1.6;
}
.msg.ai .msg-bubble {
background: var(–surface3);
border: 1px solid var(–border-soft);
border-top-left-radius: 3px; color: var(–text);
}
.msg.user .msg-bubble {
background: rgba(184,146,42,0.1);
border: 1px solid rgba(184,146,42,0.2);
border-top-right-radius: 3px; color: var(–text);
}
.msg-bubble strong { color: var(–gold-bright); }
.msg-bubble .law-ref {
background: rgba(42,139,139,0.12);
border: 1px solid rgba(42,139,139,0.2);
border-radius: 5px; padding: 6px 10px; margin-top: 6px;
font-size: 11px; color: var(–teal-light);
}

.chat-input-area {
padding: 14px 16px;
border-top: 1px solid var(–border-soft);
display: flex; gap: 9px; align-items: flex-end;
}
.chat-in {
flex: 1; background: var(–surface3);
border: 1px solid var(–border-soft);
border-radius: 8px; padding: 9px 13px;
color: var(–text); font-family: ‘Inter’, sans-serif; font-size: 12.5px;
outline: none; resize: none; line-height: 1.5;
max-height: 110px; transition: border-color 0.18s;
}
.chat-in:focus { border-color: var(–border); }
.chat-in::placeholder { color: var(–text-dim); }
.send-btn {
width: 38px; height: 38px; border-radius: 8px;
background: var(–gold); border: none; color: var(–bg);
font-size: 15px; cursor: pointer; flex-shrink: 0;
display: flex; align-items: center; justify-content: center;
transition: all 0.18s;
}
.send-btn:hover { background: var(–gold-light); }
.send-btn:disabled { opacity: 0.4; cursor: not-allowed; }

.chips-row { display: flex; flex-wrap: wrap; gap: 5px; padding: 0 16px 8px; }
.chip {
background: var(–surface3); border: 1px solid var(–border-soft);
border-radius: 15px; padding: 4px 10px;
font-size: 10.5px; color: var(–text-muted); cursor: pointer;
transition: all 0.15s;
}
.chip:hover { border-color: var(–border); color: var(–gold); }

.typing { display: flex; gap: 4px; align-items: center; }
.typing-dot {
width: 5px; height: 5px; border-radius: 50%; background: var(–text-muted);
animation: tb 1.2s infinite;
}
.typing-dot:nth-child(2) { animation-delay: .2s; }
.typing-dot:nth-child(3) { animation-delay: .4s; }
@keyframes tb { 0%,100%{transform:translateY(0);opacity:.4;} 50%{transform:translateY(-4px);opacity:1;} }

.info-box {
background: var(–surface2); border: 1px solid var(–border-soft);
border-radius: var(–radius); padding: 14px;
font-size: 12px;
}
.ib-title { font-size: 9.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 2px; color: var(–gold); margin-bottom: 8px; }
.ib-item {
display: flex; align-items: center; gap: 7px;
color: var(–text-muted); padding: 5px 0;
border-bottom: 1px solid rgba(255,255,255,0.03);
cursor: pointer; transition: color 0.15s; font-size: 11.5px;
}
.ib-item:last-child { border-bottom: none; }
.ib-item:hover { color: var(–text); }

/* ===== CONTACTS ===== */
.contacts-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 14px; }
.contact-card {
background: var(–surface2); border: 1px solid var(–border-soft);
border-radius: var(–radius); padding: 18px;
transition: border-color 0.2s;
}
.contact-card:hover { border-color: var(–border); }
.c-card-av {
width: 46px; height: 46px; border-radius: 50%;
background: var(–surface3); border: 1px solid var(–border);
