     <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:18px;">
       <div class="doc-stat"><div class="doc-stat-lbl">Score</div><div style="font-size:22px;font-weight:700;font-family:'Cormorant Garamond',serif;color:${a.score>=90?'var(--green-light)':a.score>=80?'var(--gold-bright)':a.score>=70?'#e8a840':'#e06060'};margin-top:4px;">${a.score!==null?a.score+'%':'–'}</div></div>
       <div class="doc-stat"><div class="doc-stat-lbl">Befunde</div><div style="font-size:22px;font-weight:700;font-family:'Cormorant Garamond',serif;color:var(--text);margin-top:4px;">${a.findings.length}</div></div>
       <div class="doc-stat"><div class="doc-stat-lbl">CAPAs gesamt</div><div style="font-size:22px;font-weight:700;font-family:'Cormorant Garamond',serif;color:var(--text);margin-top:4px;">${a.capas.length}</div></div>
     </div>
     <div class="modal-section">
       <div class="modal-section-title">Executive Summary</div>
       <div style="background:var(--surface3);border-radius:8px;padding:13px;font-size:12.5px;color:var(--text-muted);line-height:1.6;">${a.summary}</div>
     </div>
     ${findingsHtml ? `<div class="modal-section"><div class="modal-section-title">Audit-Befunde</div><div class="audit-findings">${findingsHtml}</div></div>` : ''}
     ${capaHtml ? `<div class="modal-section"><div class="modal-section-title">CAPA-Maßnahmen</div>${capaHtml}</div>` : ''}
     ${a.followup ? `<div class="info-alert">📅 Follow-Up geplant: <strong>${a.followup}</strong></div>` : ''}
     <div style="display:flex;gap:8px;margin-top:16px;">
       <button class="btn btn-gold" onclick="exportAuditPDF(${a.id})">⬇ Als PDF exportieren</button>
       <button class="btn btn-ghost" onclick="document.getElementById('auditDetailModal').classList.remove('open')">Schließen</button>
     </div>
   </div>`;
 document.getElementById('auditDetailModal').classList.add('open');
}

function filterAudits(type, el) {
 auditTypeFilter = type;
 document.querySelectorAll('.audit-sidebar .doc-filter-item').forEach(e => e.classList.remove('active'));
 el.classList.add('active');
 renderAuditGrid();
}

function filterAuditStatus(status, el) {
 auditStatusFilter = status;
 // Only reset status filter items, not type items
 el.closest('.doc-filter-box').querySelectorAll('.doc-filter-item').forEach(e => e.classList.remove('active'));
 el.classList.add('active');
 renderAuditGrid();
}

function searchAudits(val) { auditSearch = val.toLowerCase(); renderAuditGrid(); }

function openNewAuditModal() {
 document.getElementById('newAuditDate').value = new Date().toISOString().split('T')[0];
 document.getElementById('newAuditModal').classList.add('open');
}
function closeNewAuditModal() {
 document.getElementById('newAuditModal').classList.remove('open');
 selectedScore = null;
 document.querySelectorAll('.score-opt').forEach(o => o.classList.remove('selected'));
}

function selectScore(el, val) {
 document.querySelectorAll('.score-opt').forEach(o => o.classList.remove('selected'));
 el.classList.add('selected');
 selectedScore = parseInt(val);
}

function saveNewAudit() {
 const title = document.getElementById('newAuditTitle').value.trim();
 const type = document.getElementById('newAuditType').value;
 const country = document.getElementById('newAuditCountry').value;
 const date = document.getElementById('newAuditDate').value;
 if (!title || !type || !country || !date) { alert('Bitte alle Pflichtfelder ausfüllen.'); return; }
 const auditor = document.getElementById('newAuditAuditor').value.trim() || 'Dr. M. Keller';
 const area = document.getElementById('newAuditArea').value || 'Allgemein';
 const summary = document.getElementById('newAuditSummary').value.trim() || 'Kein Kommentar.';
 const status = document.getElementById('newAuditStatus').value;
 const followup = document.getElementById('newAuditFollowup').value || null;
 const rawFindings = document.getElementById('newAuditFindings').value.trim();
 const findings = rawFindings ? rawFindings.split('\n').filter(Boolean).map(l => {
   const sevMatch = l.match(/\[(KRITISCH|CRITICAL|MAJOR|MINOR|OBS)\]/i);
   const sev = sevMatch ? (sevMatch[1].toLowerCase() === 'kritisch' || sevMatch[1].toLowerCase() === 'critical' ? 'critical' : sevMatch[1].toLowerCase()) : 'obs';
   const icons = { critical:'🔴', major:'🟠', minor:'🟡', obs:'🔵' };
   return { sev, text: l.replace(/\[.*?\]\s*/,''), icon: icons[sev]||'🔵' };
 }) : [];
 const scoreClassMap = { 93:'score-excellent', 82:'score-good', 71:'score-fair', 60:'score-poor' };
 const formattedDate = new Date(date).toLocaleDateString('de-DE', {day:'2-digit',month:'short',year:'numeric'}).replace('.','')+' '+new Date(date).getFullYear();
 const newAudit = {
   id: audits.length + 1, type, status,
   title, area, country: country, date: formattedDate,
   auditor, score: selectedScore, scoreClass: scoreClassMap[selectedScore] || '',
   summary, findings, capas: [],
   followup: followup ? new Date(followup).toLocaleDateString('de-DE',{day:'2-digit',month:'short',year:'numeric'}) : null,
 };
 audits.unshift(newAudit);
 closeNewAuditModal();
 renderAuditGrid();
 // Reset form
 ['newAuditTitle','newAuditSummary','newAuditFindings','newAuditAuditor'].forEach(id => { const el=document.getElementById(id); if(el) el.value=''; });
 ['newAuditType','newAuditCountry','newAuditArea','newAuditStatus'].forEach(id => { const el=document.getElementById(id); if(el) el.value=''; });
}

function exportAuditPDF(id) {
 const a = audits.find(x => x.id === id);
 if (!a) return;
 const content = `PHARMACOMPLY — AUDIT REPORT\n${'='.repeat(50)}\n\nTitel: ${a.title}\nDatum: ${a.date}\nAuditor: ${a.auditor}\nScope: ${a.country}\nBereich: ${a.area}\nScore: ${a.score !== null ? a.score + '%' : 'Ausstehend'}\nStatus: ${AUDIT_STATUS_LABELS[a.status]}\n\n${'─'.repeat(50)}\nEXECUTIVE SUMMARY\n${'─'.repeat(50)}\n${a.summary}\n\n${'─'.repeat(50)}\nBEFUNDE (${a.findings.length})\n${'─'.repeat(50)}\n${a.findings.map((f,i) => `${i+1}. [${SEV_LABEL[f.sev]}] ${f.text}`).join('\n') || 'Keine Befunde.'}\n\n${'─'.repeat(50)}\nCAPAs (${a.capas.length})\n${'─'.repeat(50)}\n${a.capas.map((c,i) => `${i+1}. ${c.title}\n   → Status: ${c.status} | Fällig: ${c.due} | Owner: ${c.owner}`).join('\n\n') || 'Keine CAPAs.'}\n\n${'─'.repeat(50)}\nExportiert von PharmaComply Platform — ${new Date().toLocaleDateString('de-DE')}`;
 fakeDownload('Audit_Report_' + a.title.replace(/[^a-zA-Z0-9]/g,'_').slice(0,40) + '.txt', content);
 document.getElementById('auditDetailModal').classList.remove('open');
}

// Close modals on overlay click
document.addEventListener('click', e => {
 if (e.target.id === 'newAuditModal') closeNewAuditModal();
 if (e.target.id === 'auditDetailModal') document.getElementById('auditDetailModal').classList.remove('open');
});

function nav(id) {
 document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
 document.querySelectorAll('.nav-item').forEach(n=>{
   n.classList.remove('active');
   if(n.getAttribute('onclick')===`nav('${id}')`) n.classList.add('active');
 });
 document.getElementById('page-'+id).classList.add('active');
 document.getElementById('topbarTitle').textContent = titles[id]||id;
}

function filterCountries() {
 const val = document.getElementById('statusFilter').value;
 const f = val==='all' ? countries : countries.filter(c=>c.status===val);
 document.getElementById('allCountryGrid').innerHTML = f.map(c=>renderCC(c)).join('');
}

function filterContacts(type, btn) {
 document.querySelectorAll('.contacts-grid').length;
 document.querySelectorAll('[onclick^="filterContacts"]').forEach(b=>{b.className='btn btn-ghost btn-sm';});
 btn.className='btn btn-gold btn-sm';
 const f = type==='all' ? allContacts : allContacts.filter(c=>c.type===type);
 document.getElementById('contactsGrid').innerHTML = f.map(c=>renderContact(c)).join('');
}

function searchHandler(val) {
 if(!val.trim()) return;
 const q = val.toLowerCase();
 const matched = countries.filter(c=>
   c.name.toLowerCase().includes(q)||
   c.tags.some(t=>t.toLowerCase().includes(q))||
   c.laws.some(l=>l.name.toLowerCase().includes(q)||l.desc.toLowerCase().includes(q))
 );
 if(matched.length>0) {
   nav('countries');
   document.getElementById('allCountryGrid').innerHTML = matched.map(c=>renderCC(c)).join('');
 }
}

// =================== AI CHAT ===================
function doSend() {
 const inp = document.getElementById('chatInput');
 const msg = inp.value.trim();
 if(!msg) return;
 inp.value=''; inp.style.height='';
 addMsg(msg,'user');
 showTyping();
 setTimeout(()=>{
   hideTyping();
   const r = getAIResponse(msg);
   addMsg(r,'ai');
 }, 700+Math.random()*600);
}

function quickSend(msg) {
 document.getElementById('chatInput').value = msg;
 doSend();
}

function addMsg(text, role) {
 const ca = document.getElementById('chatArea');
 const d = document.createElement('div');
 d.className=`msg ${role}`;
 // Convert markdown-like to HTML
 let html = text
   .replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>')
   .replace(/\n/g,'<br>');
 d.innerHTML=`<div class="msg-av ${role}-type">${role==='ai'?'🤖':'MK'}</div><div class="msg-bubble">${html}</div>`;
 ca.appendChild(d); ca.scrollTop=ca.scrollHeight;
}

let typEl;
function showTyping() {
 const ca=document.getElementById('chatArea');
 typEl=document.createElement('div'); typEl.className='msg ai'; typEl.id='typInd';
 typEl.innerHTML=`<div class="msg-av ai-type">🤖</div><div class="msg-bubble"><div class="typing"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div></div>`;
 ca.appendChild(typEl); ca.scrollTop=ca.scrollHeight;
 document.getElementById('sendBtn').disabled=true;
}
function hideTyping() { typEl&&typEl.remove(); document.getElementById('sendBtn').disabled=false; }
function clearChat() {
 document.getElementById('chatArea').innerHTML=`<div class="msg ai"><div class="msg-av ai-type">🤖</div><div class="msg-bubble">Chat zurückgesetzt. Wie kann ich Ihnen helfen?</div></div>`;
}
function handleKey(e) { if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();doSend();} }
function autoResize(el) { el.style.height=''; el.style.height=Math.min(el.scrollHeight,110)+'px'; }

