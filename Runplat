function getDocIcon(ext) { return DOC_ICONS[ext] || DOC_ICONS.default; }
function getDocIconClass(ext) { return DOC_ICON_CLASS[ext] || 'doc-icon-other'; }
function getDocCatClass(cat) { return `cat-${cat}`; }

function getFilteredDocs() {
 let list = [...documents];
 if (docFilter !== 'all') list = list.filter(d => d.cat === docFilter);
 if (docSearch) list = list.filter(d => d.name.toLowerCase().includes(docSearch) || d.desc.toLowerCase().includes(docSearch) || d.country.toLowerCase().includes(docSearch));
 list.sort((a, b) => {
   if (docSortMode === 'date-desc') return b.id - a.id;
   if (docSortMode === 'date-asc') return a.id - b.id;
   if (docSortMode === 'name-asc') return a.name.localeCompare(b.name);
   if (docSortMode === 'name-desc') return b.name.localeCompare(a.name);
   if (docSortMode === 'size-desc') return parseFloat(b.size) - parseFloat(a.size);
   return 0;
 });
 return list;
}

function renderDocGrid() {
 const list = getFilteredDocs();
 const grid = document.getElementById('docGrid');
 if (!list.length) { grid.innerHTML = `<div style="padding:40px;text-align:center;color:var(--text-muted);">Keine Dokumente gefunden.</div>`; return; }
 grid.innerHTML = list.map(d => {
   const expiryHtml = d.expiry ? `<span style="color:${isExpiringSoon(d.expiry)?'#e8a840':'var(--text-muted)'}">⏱ Ablauf: ${d.expiry}</span>` : '';
   return `<div class="doc-item ${getDocCatClass(d.cat)}" onclick="previewDoc(${d.id})">
     <div class="doc-icon-wrap ${getDocIconClass(d.ext)}">${getDocIcon(d.ext)}</div>
     <div class="doc-info">
       <div class="doc-name">${d.name}</div>
       <div class="doc-meta">
         <span>🌍 ${d.country}</span>
         <span>📅 ${d.date}</span>
         <span>💾 ${d.size}</span>
         <span style="color:var(--text-muted);">👤 ${d.uploader}</span>
         ${expiryHtml}
       </div>
     </div>
     <div class="doc-actions">
       <button class="doc-action-btn" title="Vorschau" onclick="event.stopPropagation();previewDoc(${d.id})">👁</button>
       <button class="doc-action-btn" title="Herunterladen" onclick="event.stopPropagation();fakeDownload('${d.name}')">⬇</button>
       <button class="doc-action-btn" title="Löschen" onclick="event.stopPropagation();deleteDoc(${d.id})" style="color:#e06060;">🗑</button>
     </div>
   </div>`;
 }).join('');
 updateDocStats();
}

function isExpiringSoon(expiry) {
 if (!expiry) return false;
 const parts = expiry.split(' ');
 const months = {Jan:0,Feb:1,Mar:2,Apr:3,May:4,Jun:5,Jul:6,Aug:7,Sep:8,Oct:9,Nov:10,Dec:11};
 try { const d = new Date(parseInt(parts[2]), months[parts[1]]||0, 1); return (d - new Date()) < 60*24*3600*1000; } catch(e) { return false; }
}

function updateDocStats() {
 document.getElementById('statTotal').textContent = documents.length;
 document.getElementById('docCountBadge').textContent = documents.length;
 const counts = { regulatory:0, pv:0, audit:0, contract:0, other:0 };
 documents.forEach(d => { if(counts[d.cat]!==undefined) counts[d.cat]++; });
 document.getElementById('fAll').textContent = documents.length;
 document.getElementById('fReg').textContent = counts.regulatory;
 document.getElementById('fPV').textContent = counts.pv;
 document.getElementById('fAudit').textContent = counts.audit;
 document.getElementById('fContract').textContent = counts.contract;
 document.getElementById('fOther').textContent = counts.other;
}

function filterDocs(cat, el) {
 docFilter = cat;
 document.querySelectorAll('.doc-filter-item').forEach(e => e.classList.remove('active'));
 el.classList.add('active');
 renderDocGrid();
}

function searchDocs(val) { docSearch = val.toLowerCase(); renderDocGrid(); }
function sortDocs(val) { docSortMode = val; renderDocGrid(); }

function handleFileSelect(files) {
 if (!files || !files.length) return;
 Array.from(files).forEach((file, i) => {
   setTimeout(() => simulateUpload(file), i * 400);
 });
}

function simulateUpload(file) {
 const id = 'prog_' + Date.now() + '_' + Math.random().toString(36).substr(2,5);
 const container = document.getElementById('uploadProgress');
 const el = document.createElement('div');
 el.className = 'progress-item'; el.id = id;
 el.innerHTML = `
   <div class="progress-name">⬆ ${file.name}</div>
   <div class="progress-bar-wrap"><div class="progress-bar-fill" id="bar_${id}" style="width:0%"></div></div>
   <div class="progress-meta"><span>Wird hochgeladen…</span><span id="pct_${id}">0%</span></div>`;
 container.appendChild(el);
 let pct = 0;
 const interval = setInterval(() => {
   pct += Math.random() * 18 + 5;
   if (pct >= 100) { pct = 100; clearInterval(interval);
     document.getElementById(`bar_${id}`).style.width = '100%';
     document.getElementById(`pct_${id}`).textContent = '100%';
     el.querySelector('.progress-meta span').textContent = '✓ Fertig';
     el.style.borderColor = 'rgba(42,139,90,0.4)';
     // Add to documents array
     const ext = file.name.split('.').pop().toLowerCase();
     const sizeKB = (file.size/1024);
     const sizeStr = sizeKB > 1024 ? `${(sizeKB/1024).toFixed(1)} MB` : `${Math.round(sizeKB)} KB`;
     const newDoc = { id: documents.length+1, name: file.name, cat:'other', country:'Nicht zugewiesen', size: sizeStr, date:'Heute', ext, uploader:'Dr. M. Keller', expiry:null, desc:'Neu hochgeladen — Kategorie bitte zuweisen.' };
     documents.unshift(newDoc);
     renderDocGrid();
     setTimeout(() => { el.style.opacity='0'; el.style.transition='opacity 0.5s'; setTimeout(()=>el.remove(), 500); }, 2200);
   } else {
     document.getElementById(`bar_${id}`).style.width = pct + '%';
     document.getElementById(`pct_${id}`).textContent = Math.round(pct) + '%';
   }
 }, 120);
}

