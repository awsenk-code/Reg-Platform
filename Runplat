 document.getElementById('dashCountryGrid').innerHTML = countries.slice(0,4).map(c=>renderCC(c)).join('');
 document.getElementById('allCountryGrid').innerHTML = countries.map(c=>renderCC(c)).join('');
 document.getElementById('contactsGrid').innerHTML = allContacts.map(c=>renderContact(c)).join('');
 document.getElementById('pricingContent').innerHTML = renderPricing();
 document.getElementById('advertisingContent').innerHTML = renderAdvertising();
 document.getElementById('updatesContent').innerHTML = renderUpdates();
 renderDocGrid();
 renderAuditGrid();
}

init();
</script>

